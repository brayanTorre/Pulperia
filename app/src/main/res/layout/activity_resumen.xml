<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Volver al menú" />

    <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="22sp"
        android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Top 5 por valor" android:textStyle="bold" android:paddingTop="16dp" />
    <ListView android:id="@+id/lvTop" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="⚠ Stock bajo" android:textStyle="bold" />
    <ListView android:id="@+id/lvBajo" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
