<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <Spinner android:id="@+id/spProducto" android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <EditText android:id="@+id/etCantidad" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Cantidad"
        android:inputType="number" />
    <RadioGroup android:id="@+id/rgTipo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioButton android:id="@+id/rbEntrada" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Entrada" android:checked="true" />
        <RadioButton android:id="@+id/rbSalida" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Salida" />
    </RadioGroup>
    <Button android:id="@+id/btnRegistrar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Registrar movimiento" />
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Volver al menú" />
</LinearLayout>
